{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/connection.v1.schema.json",
  "title": "connection body, version 1",
  "type": "object",
  "properties": {
    "connector": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "maxLength": 255,
      "description": "The connector: `http` or `smtp`, which every worker has, or the path of a connector resource."
    },
    "description": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "connector"
  ],
  "additionalProperties": false
}
