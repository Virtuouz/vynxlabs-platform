{
  "name": "@vynxlabs/ui",
  "version": "0.4.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"fs.copyFileSync('src/tokens.css', 'dist/tokens.css')\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vega": "^6.4.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
