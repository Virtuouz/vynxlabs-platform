{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/tenant_role.v1.schema.json",
  "title": "tenant_role file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
      "description": "Its key, when that is not the file's name. It never changes."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(.*\\S)?$",
          "description": "What people read. It can change: nothing refers to it."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "What it is for, in plain text."
        },
        "permissions": {
          "type": "array",
          "description": "What the role allows, each as `kind:verb` such as `table:read`, with `*` for either half.",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z][a-z0-9_]*):(\\*|read|write)$"
          },
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "required": [
        "permissions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
