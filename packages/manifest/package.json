{
  "name": "@volvel/manifest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "default": "./dist/action.js"
    },
    "./parts": {
      "types": "./dist/parts.d.ts",
      "default": "./dist/parts.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@volvel/widgets": "workspace:*",
    "@volvel/widgets-core": "workspace:*",
    "ajv": "^8.20.0",
    "typebox": "^1.4.6",
    "yaml": "^2.9.1"
  }
}
