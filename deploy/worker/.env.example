# The same image the instance runs, at the same version.
VOLVEL_IMAGE=

# The address of the instance, as the worker reaches it.
VOLVEL_URL=https://platform.example.com

# The worker credential is not set here. Create it in the console, on the tenant's Workers
# page (give it a pool to have this worker run only the scripts that name that pool), and save
# it as the one line of a file named worker-token beside compose.yaml:
#   umask 077; printf '%s\n' 'the credential' > worker-token

# Runs handled at once. Empty: 4.
VOLVEL_WORKER_CONCURRENCY=
# Seconds with nothing to do before the worker exits. Empty: it stays. Compose restarts it at
# once, so leave this empty unless the container is started on demand.
VOLVEL_WORKER_IDLE_EXIT=
