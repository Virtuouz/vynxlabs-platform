{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/trigger.v1.schema.json",
  "title": "trigger body, version 1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "webhook"
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255
        },
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255,
          "description": "A trigger source to hand each request or each tick to first. What it returns is what starts the script or flow."
        },
        "input": {
          "enum": [
            "body",
            "request"
          ],
          "description": "What the script or flow is given. `body` is the parsed body alone, and the default. `request` is `{ body, headers, rawBody, query, method }`, for a sender whose headers matter."
        },
        "verify": {
          "type": "object",
          "description": "Checks that a request was signed with a shared secret before anything starts. A request that fails is answered 401. Covers senders that put an HMAC of the body in a header, such as GitHub, Shopify and Slack.",
          "properties": {
            "scheme": {
              "enum": [
                "hmac-sha256",
                "hmac-sha1"
              ]
            },
            "header": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$",
              "maxLength": 100,
              "description": "The header the signature is sent in."
            },
            "secret": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "The name of the workspace secret that holds the shared secret."
            },
            "encoding": {
              "enum": [
                "hex",
                "base64"
              ],
              "description": "How the signature is written. Default hex."
            },
            "prefix": {
              "type": "string",
              "maxLength": 20,
              "description": "Text before the signature in the header, such as `sha256=`."
            },
            "signed": {
              "type": "string",
              "maxLength": 100,
              "description": "What was signed, with `{body}` for the raw body and `{timestamp}` for the timestamp header. Default `{body}`. Slack signs `v0:{timestamp}:{body}`."
            },
            "timestampHeader": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+$",
              "maxLength": 100,
              "description": "A header holding when the request was sent, in seconds since 1970."
            },
            "toleranceSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400,
              "description": "How old a request may be, by its timestamp header. Default 300."
            }
          },
          "required": [
            "scheme",
            "header",
            "secret"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "script"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255
        },
        "event": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255,
          "description": "The event to listen for."
        },
        "filter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "CEL over `event`. The script runs only when it is true."
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "script",
        "event"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "form"
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255
        },
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63,
                "description": "The key the value has in the input."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "enum": [
                  "text",
                  "textarea",
                  "email",
                  "number",
                  "date",
                  "select",
                  "checkbox"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "help": {
                "type": "string",
                "maxLength": 300
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "description": "What a select offers."
              }
            },
            "required": [
              "name",
              "label",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "submitLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "success": {
          "type": "string",
          "maxLength": 500,
          "description": "What is shown once the form was sent."
        },
        "access": {
          "enum": [
            "anyone",
            "signed_in"
          ],
          "description": "Who may send the form. `signed_in` asks for a sign-in to the tenant's portal first. Default `anyone`."
        }
      },
      "required": [
        "type",
        "script",
        "title",
        "fields"
      ],
      "additionalProperties": false
    }
  ]
}
