{
  "type": "object",
  "required": [
    "formatVersion",
    "sdkVersion",
    "core",
    "manifests",
    "code",
    "digest"
  ],
  "properties": {
    "formatVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ],
      "description": "2 adds `assets`. 3 lets a manifest be console-managed, and then speaks for every console-managed resource of the workspace. A bundle with neither is still written as 1."
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "core": {
      "type": "object",
      "required": [
        "min",
        "below"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Lowest core version it runs on."
        },
        "below": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "First core version it does not run on."
        }
      },
      "additionalProperties": false
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "schemaVersion",
          "path",
          "ownership",
          "body"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 63
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
            "maxLength": 255
          },
          "ownership": {
            "anyOf": [
              {
                "type": "string",
                "const": "code"
              },
              {
                "type": "string",
                "const": "ui"
              }
            ]
          },
          "body": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "code": {
      "type": "string",
      "description": "One ES module exporting every code-backed resource."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "app",
          "path",
          "sha256",
          "size",
          "contentType"
        ],
        "properties": {
          "app": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
            "maxLength": 255,
            "description": "The path of the app resource the file belongs to."
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._@~-]*(/[A-Za-z0-9][A-Za-z0-9._@~-]*)*$",
            "maxLength": 500,
            "description": "The file's path inside the app, for example assets/index-3f9a.js."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "contentType": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "maxItems": 5000,
      "description": "The files of the bundle's apps. Format 2 only."
    },
    "sources": {
      "type": "object",
      "required": [
        "files",
        "map"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500,
                "description": "Relative to the repository root."
              },
              "content": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 2000
        },
        "map": {
          "type": "string",
          "description": "A source map (version 3) from `code` to the files, without their contents."
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the other fields."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle.schema.json",
  "title": "Bundle",
  "description": "An immutable package of one workspace's manifests and code.",
  "additionalProperties": false
}
