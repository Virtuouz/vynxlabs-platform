{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/trigger.v1.schema.json",
  "title": "trigger body, version 1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "webhook"
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "script"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255
        },
        "event": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
          "maxLength": 255,
          "description": "The event to listen for."
        },
        "filter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "CEL over `event`. The script runs only when it is true."
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "script",
        "event"
      ],
      "additionalProperties": false
    }
  ]
}
