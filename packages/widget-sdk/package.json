{
  "name": "@volvel/widgets",
  "version": "0.5.0",
  "type": "module",
  "description": "The widget contract: what a widget for Volvel's pages and dashboards declares, and what its view is given.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "default": "./dist/action.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "default": "./dist/frame.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./pattern": {
      "types": "./dist/pattern.d.ts",
      "default": "./dist/pattern.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "re2js": "^2.10.0"
  }
}
