# Settings for the single-host stack. Avoid characters that need escaping in a URL.
# Every setting of the instance can be set here: see "Settings" in the documentation. The ones
# below are the ones to look at first, and the rest follow at the end.

# Which bundled services to start: a database (`postgres`) and an object store (`objectstore`).
# Leave one out when you give your own, below. Without this line neither is started.
COMPOSE_PROFILES=postgres,objectstore

# Your own database or object store, in place of the bundled ones. Leave the matching profile
# out of COMPOSE_PROFILES. For AWS S3, set S3_ENDPOINT= to nothing.
# DATABASE_URL=postgres://user:password@db.example.com:5432/volvel
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Long random values, for example from `openssl rand -hex 24`.
POSTGRES_PASSWORD=
OBJECTSTORE_SECRET=

# Signs session cookies. `openssl rand -hex 32`
AUTH_SECRET=

# Wraps every tenant's encryption key. `openssl rand -base64 32`
# Back this up somewhere safe. Without it, no stored secret can ever be read again.
MASTER_KEY=
# Only while rotating the master key: the other key of the rotation. See
# "Rotating the master key" in docs/self-hosting.md.
MASTER_KEY_SECONDARY=

# The URL people type to reach the console, for example https://platform.example.com
PUBLIC_URL=http://localhost:8080

# Creates the first operator admin on the first start, when there are no members.
# The password needs at least 12 characters. Remove both lines afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# A second address for apps, for example https://apps.example.com, another hostname
# that reaches this same instance. Apps written as code are served there, never where the
# console's sign-in is. Without it they are not served at all, unless you knowingly set
# APPS_ON_CONSOLE_ADDRESS=true. Interfaces built in the console work either way.
# APPS_URL=
# APPS_ON_CONSOLE_ADDRESS=false

# Optional: where to send mail, for end users' invitations and password resets, and for
# approvers of a flow's approval step. Without it nothing is sent, and whoever asks for a
# link passes it on.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Acme <no-reply@example.com>

# Lets the worker host ask the control plane for work. `openssl rand -hex 32`
WORKER_HOST_TOKEN=

# Managed workers: a worker per tenant with work, started by the worker host, in a
# container on a network of its own. `process` starts them beside the control plane
# instead, only for tenants whose code only the operator writes. `false` starts none,
# for when every tenant is served by standalone workers.
# MANAGED_WORKERS=host

# Private networks and names that a tenant's scripts may reach, for the worker host's firewall
# (it needs the NET_ADMIN capability, which the compose file gives it). Empty by default: a script
# reaches nothing private. This is not EGRESS_ALLOW, which is what the instance itself may reach.
# WORKER_EGRESS_ALLOW=

# The instance does not reach private or internal addresses for a tenant (an SSO
# provider's metadata, a Git remote, a data source). List the ones it may, as networks
# and host names, for example 10.20.0.0/16,git.internal
# EGRESS_ALLOW=

# Whose forwarding headers are believed when the instance learns who is calling: how many
# proxies sit in front of it (default 1), or the networks they are on. 0 for an instance
# reached directly. The proxy must set X-Forwarded-For to the caller's address itself.
# TRUSTED_PROXIES=1

# Where the control plane listens on the host. Put a TLS-terminating reverse
# proxy in front of it before exposing it beyond this machine.
VOLVEL_BIND=127.0.0.1:8080

# Optional: a published image to run instead of building from source.
# VOLVEL_IMAGE=

# The rest of the instance's settings, each with what it does when not set.

# Address
# How much is logged: fatal, error, warn, info, debug, trace or silent. Default: info.
# LOG_LEVEL=
# The address of the documentation on the web, such as https://docs.example.com.
# DOCS_URL=

# Database
# Connections for the instance's own work, for each replica. Default: 10.
# DATABASE_POOL_SIZE=
# Connections for every tenant's table requests, for each replica. Default: 10.
# DATA_POOL_SIZE=
# Table requests one tenant may have open at once, for each replica. Default: A third of DATA_POOL_SIZE, at least 2.
# DATA_TENANT_CONNECTIONS=
# How long one request for rows may take, in milliseconds. Default: 15000.
# DATA_STATEMENT_TIMEOUT_MS=
# How long one query written in SQL may run before it is stopped, in milliseconds. Default: 15000.
# SQL_STATEMENT_TIMEOUT_MS=

# Files
# The store's region. Default: us-east-1.
# S3_REGION=
# true puts the bucket in the path, as most stores other than Amazon's need. Default: true.
# S3_FORCE_PATH_STYLE=

# Secrets
# Lets a scraper read the metrics with this token and no sign-in.
# METRICS_TOKEN=

# Workers
# With process: own runs workers as a user of their own, same as the control plane's. Default: own.
# MANAGED_WORKER_USER=
# The first user workers run as. Default: 10001.
# MANAGED_WORKER_UID=
# The first group workers run as. Default: 10001.
# MANAGED_WORKER_GID=
# How many users, counted from MANAGED_WORKER_UID, the worker host may use: it never runs more workers at once than this. Default: 256.
# MANAGED_WORKER_USERS=
# With process: managed workers alive at once. Default: Twice the run slots.
# MANAGED_WORKERS_MAX=
# Scripts running at once on this machine. Default: From memory: one for each 160 MB past the first 512 MB, at least 2.
# RUN_SLOTS=
# Free memory below which no worker here takes more work. Default: A tenth of memory, at least 128.
# RUN_MEMORY_FLOOR_MB=

# Limits
# Queued runs in a workspace past which its schedules pass over their times. Default: 200.
# SCHEDULE_BACKLOG_LIMIT=
# true pauses every trigger of the instance, whatever the console says. Default: false.
# TRIGGERS_PAUSED=

# Retention
# How long runs and their logs are kept, unless a tenant says otherwise. Default: 30.
# RETENTION_RUNS_DAYS=
# How long events are kept. Default: 30.
# RETENTION_EVENTS_DAYS=
# How long refused requests are kept. Default: 7.
# RETENTION_REFUSALS_DAYS=
# How long audit entries are kept. Default: 400.
# RETENTION_AUDIT_DAYS=

# Telemetry
# Where traces and metrics are sent, such as http://collector:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers to send with them, as name=value,name=value.
# OTEL_EXPORTER_OTLP_HEADERS=
# The protocol. Default: http/json.
# OTEL_EXPORTER_OTLP_PROTOCOL=
# What the instance calls itself. Default: volvel.
# OTEL_SERVICE_NAME=
# none sends no traces.
# OTEL_TRACES_EXPORTER=
# none sends no metrics.
# OTEL_METRICS_EXPORTER=
# How often metrics are sent, in milliseconds. Default: 60000.
# OTEL_METRIC_EXPORT_INTERVAL=
# false leaves the workspace out of each metric, where there are too many workspaces for the store that keeps them. Default: true.
# METRICS_WORKSPACE_LABELS=
