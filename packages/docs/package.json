{
  "name": "@volvel/docs",
  "version": "0.5.0",
  "type": "module",
  "description": "Volvel's own documentation: the pages, and the built trees, manifest and search index the console and the website read.",
  "license": "Apache-2.0",
  "exports": {
    "./manifest.json": "./dist/manifest.json",
    "./search.json": "./dist/search.json",
    "./fields.json": "./dist/fields.json",
    "./redirects.json": "./dist/redirects.json",
    "./pages/*": "./dist/pages/*",
    "./content/*": "./content/*",
    "./assets/*": "./dist/assets/*",
    "./openapi.json": "./generated/openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "content",
    "generated",
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "node generate.mjs && node build.mjs",
    "check": "node check.mjs",
    "generate": "node generate.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@volvel/control-plane": "workspace:*",
    "@volvel/docs-engine": "workspace:*",
    "@volvel/manifest": "workspace:*",
    "@volvel/markup": "workspace:*"
  }
}
