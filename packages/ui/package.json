{
  "name": "@volvel/ui",
  "version": "0.5.0",
  "type": "module",
  "description": "Volvel's component kit: the components the console and tenants' apps are drawn with, on theme tokens.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./type-scale.css": "./src/type-scale.css",
    "./icons": "./src/icons.ts"
  },
  "files": [
    "dist",
    "fonts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"fs.copyFileSync('src/tokens.css', 'dist/tokens.css'); fs.copyFileSync('src/type-scale.css', 'dist/type-scale.css')\"",
    "typecheck": "tsc -p ."
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tokens.css": "./dist/tokens.css",
      "./type-scale.css": "./dist/type-scale.css",
      "./icons": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-virtual": "3.14.28",
    "@volvel/markup": "workspace:*",
    "@volvel/widgets": "workspace:*",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vega": "^6.4.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.1",
    "happy-dom": "^21.0.4"
  }
}
