{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/flow.v1.schema.json",
  "title": "flow body, version 1",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 63
      },
      "minProperties": 1,
      "maxProperties": 200,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "trigger"
              },
              "trigger": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "manual"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "webhook"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "schedule"
                      },
                      "cron": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "timezone": {
                        "type": "string",
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "type",
                      "cron"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "event"
                      },
                      "event": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                        "maxLength": 255
                      },
                      "filter": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "description": "A CEL expression."
                      }
                    },
                    "required": [
                      "type",
                      "event"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "type",
              "trigger"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "script"
              },
              "script": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                "maxLength": 255
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "A CEL expression."
              }
            },
            "required": [
              "type",
              "script"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "set"
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "A CEL expression."
                },
                "minProperties": 1,
                "maxProperties": 50
              }
            },
            "required": [
              "type",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "branch"
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "maxLength": 63
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "description": "A CEL expression."
                    }
                  },
                  "required": [
                    "name",
                    "when"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "cases"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "foreach"
              },
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "A CEL expression."
              },
              "script": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                "maxLength": 255
              },
              "flow": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                "maxLength": 255
              },
              "flowFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "An expression that gives the path of the flow to start. It must give one of the paths in `allow`."
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                  "maxLength": 255
                },
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "description": "The flows `flowFrom` may choose. Each is checked like a flow named outright: it must exist, be startable, and not lead back here."
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "A CEL expression."
              },
              "concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "type",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "join"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "delay"
              },
              "seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2592000
              }
            },
            "required": [
              "type",
              "seconds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "approval"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "A CEL expression."
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2592000
              }
            },
            "required": [
              "type",
              "title"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "subflow"
              },
              "flow": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                "maxLength": 255
              },
              "flowFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "An expression that gives the path of the flow to start. It must give one of the paths in `allow`."
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                  "maxLength": 255
                },
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "description": "The flows `flowFrom` may choose. Each is checked like a flow named outright: it must exist, be startable, and not lead back here."
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "A CEL expression."
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "fail"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "A CEL expression."
              }
            },
            "required": [
              "type",
              "message"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "output": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "error": {
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "description": "Where each node sits in the editor, for a flow drawn in the console. It changes nothing about how the flow runs.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 63
      },
      "maxProperties": 200,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
