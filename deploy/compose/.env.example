# Settings for the single-host stack. Avoid characters that need escaping in a URL.

# Long random values, for example from `openssl rand -hex 24`.
POSTGRES_PASSWORD=
OBJECTSTORE_SECRET=

# Signs session cookies. `openssl rand -hex 32`
AUTH_SECRET=

# Wraps every tenant's encryption key. `openssl rand -base64 32`
# Back this up somewhere safe. Without it, no stored secret can ever be read again.
MASTER_KEY=

# The URL people type to reach the console, for example https://platform.example.com
PUBLIC_URL=http://localhost:8080

# Creates the first operator admin on the first start, when there are no members.
# The password needs at least 12 characters. Remove both lines afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# The control plane starts a worker per tenant when there is work. Set this to
# false only if every tenant is served by standalone workers.
# MANAGED_WORKERS=true

# Where the control plane listens on the host. Put a TLS-terminating reverse
# proxy in front of it before exposing it beyond this machine.
PLATFORM_BIND=127.0.0.1:8080

# Optional: a published image to run instead of building from source.
# PLATFORM_IMAGE=
