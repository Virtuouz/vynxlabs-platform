{
  "name": "@volvel/manifest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./digest": {
      "types": "./dist/digest.d.ts",
      "default": "./dist/digest.js"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "default": "./dist/action.js"
    },
    "./parts": {
      "types": "./dist/parts.d.ts",
      "default": "./dist/parts.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@volvel/widgets": "workspace:*",
    "@volvel/widgets-core": "workspace:*",
    "@volvel/widgets-labs": "workspace:*",
    "ajv": "^8.20.0",
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  },
  "sideEffects": false
}
