{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/widget.v1.schema.json",
  "title": "widget body, version 1",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^x/[a-z][a-z0-9-]{0,40}$",
      "description": "The widget's type, in the tenant's own namespace: `x/<name>`. The other namespaces are Volvel's. A resource's path is its type."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver. A page records the version it was placed with and keeps drawing that version until someone updates it. A version's files never change once deployed: change the widget, raise the version."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "What it is called."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "One line, said in \"Add to page\"."
    },
    "category": {
      "enum": [
        "records",
        "action",
        "understand",
        "organize",
        "content"
      ],
      "description": "The group \"Add to page\" lists it under."
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The name of an icon from the kit's set. Any other name is drawn as a puzzle piece."
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "app",
          "dashboard"
        ],
        "description": "`app` or `dashboard`."
      },
      "description": "Where it may be put: an app's page, a dashboard."
    },
    "data": {
      "type": "object",
      "description": "What it reads, by input name: Volvel reads it under the viewer's permissions and gives it to the view.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "shape": {
            "enum": [
              "rows",
              "summary",
              "record",
              "approvals"
            ],
            "description": "What it is given: `rows`, `summary`, `record` or `approvals`."
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "description": "What the inspector calls it when there is more than one. Left out: \"Source\"."
          },
          "required": {
            "type": "boolean",
            "description": "Whether the widget cannot be drawn without it. Default true."
          },
          "sources": {
            "type": "array",
            "items": {
              "enum": [
                "table",
                "query",
                "sql",
                "approvals"
              ],
              "description": "Where it may come from."
            },
            "description": "Where it may come from: a table, a query, SQL or approvals."
          },
          "values": {
            "type": "object",
            "description": "For a summary: how many values it may work out.",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0,
                "description": "The fewest."
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "description": "The most."
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "breakdowns": {
            "type": "object",
            "description": "For a summary: how many ways it may be broken down.",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0,
                "description": "The fewest."
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "description": "The most."
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "shape"
        ],
        "additionalProperties": false
      }
    },
    "dataHints": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "description": "One data input's controls, by `of` and `controls`."
      },
      "description": "The Data tab's controls for each input."
    },
    "config": {
      "type": "object",
      "description": "A JSON Schema (draft 2020-12) for the widget's settings, an object with `properties`, each with an `x-volvel` hint saying how the inspector draws it from the fixed set of controls.",
      "properties": {
        "type": {
          "const": "object",
          "description": "Always `object`."
        },
        "properties": {
          "type": "object",
          "description": "Each setting by name: its JSON Schema with an `x-volvel` hint."
        }
      },
      "required": [
        "type",
        "properties"
      ]
    },
    "words": {
      "type": "object",
      "description": "What each setting is, by its path in `config`, where the schema does not say.",
      "additionalProperties": {
        "type": "string",
        "description": "What the setting is."
      }
    },
    "defaults": {
      "type": "object",
      "description": "What the widget is when it is added, before anyone changes it."
    },
    "events": {
      "type": "object",
      "description": "What can happen to the widget that an action may be attached to, by name.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "gives": {
            "enum": [
              "record",
              "group",
              "nothing"
            ],
            "description": "What it gives the action attached to it: a `record`, a `group` or `nothing`."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Said in the Actions tab: \"When a row is clicked\"."
          },
          "payload": {
            "type": "object",
            "description": "A JSON Schema for what the frame sends with it. The host drops what does not fit."
          }
        },
        "required": [
          "gives",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "description": "Its size in the page's grid, and what it does on a phone.",
      "properties": {
        "min": {
          "type": "object",
          "description": "The smallest it may be made.",
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Columns wide, of the page's twelve."
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "Rows high, of 40 pixels each."
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "default": {
          "type": "object",
          "description": "The size it is added with.",
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Columns wide, of the page's twelve."
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "Rows high, of 40 pixels each."
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "max": {
          "type": "object",
          "description": "The largest it may be made.",
          "properties": {
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Columns wide, of the page's twelve."
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "Rows high, of 40 pixels each."
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "phone": {
          "enum": [
            "stack",
            "list",
            "hide"
          ],
          "description": "On a narrow screen: full width, drawn as a list, or not shown."
        },
        "frame": {
          "enum": [
            "card",
            "none"
          ],
          "description": "Whether the page draws it on a card with its title (the default) or as it is."
        }
      },
      "required": [
        "min",
        "default"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_@.-]+(/[A-Za-z0-9_@.-]+)*$",
      "maxLength": 500,
      "description": "The file in the repository that is the view: a module that draws it with `@volvel/widget-frame`. Built into one script at deploy."
    }
  },
  "required": [
    "type",
    "version",
    "title",
    "description",
    "category",
    "icon",
    "surfaces",
    "data",
    "config",
    "events",
    "layout",
    "entry"
  ],
  "additionalProperties": false
}
