{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/binding.v1.schema.json",
  "title": "binding file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's identity, when that is not its path. Say it when you move the file: the path the resource had. It never changes."
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's path, when the file is kept somewhere that does not give it one."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "The name of a role visible in this workspace."
        },
        "principal": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "member"
                },
                "email": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "email"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "group",
                    "service_account",
                    "end_user_group"
                  ],
                  "description": "group is a group of members. end_user_group is a group of end users."
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
                  "description": "Its key, which never changes. What it is called can change without this binding noticing."
                }
              },
              "required": [
                "type",
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "group",
                    "service_account",
                    "end_user_group"
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "Its title, as bindings named it before keys. It still works, and stops working when the title changes: name it by `key`."
                }
              },
              "required": [
                "type",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "end_user"
                },
                "email": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "email"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "anonymous",
                    "end_users"
                  ],
                  "description": "anonymous is anyone, signed in or not. end_users is every signed-in end user of the tenant."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ]
        },
        "resource": {
          "type": "string",
          "description": "Path of one resource to bind at. Omit to bind at the workspace."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Why the grant is there, for whoever reads it later."
        }
      },
      "required": [
        "role",
        "principal"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "body"
  ],
  "additionalProperties": false
}
