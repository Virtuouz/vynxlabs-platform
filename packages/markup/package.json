{
  "name": "@volvel/markup",
  "version": "0.7.0",
  "type": "module",
  "description": "One page of documentation: Markdown to a checked tree, drawn as React, HTML or plain text. Nothing in it runs as code.",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/prism.js",
    "./dist/prism-manual.js",
    "./dist/prism-global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "prismjs": "1.30.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
