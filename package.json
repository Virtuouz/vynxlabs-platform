{
  "name": "volvel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @volvel/docs build && pnpm --filter @volvel/console build && pnpm --filter @volvel/screens build",
    "typecheck": "tsc -b && node packages/cli/dist/bin.js types --dir examples/acme && node packages/cli/dist/bin.js types --dir examples/fernhill && tsc -p packages/ui && tsc -p packages/app && tsc -p packages/screens && tsc -p packages/widgets-core/views && tsc -p packages/widgets-labs/views && tsc -p apps/console && tsc -p examples/acme && tsc -p examples/higher-ed-devices && tsc -p examples/fernhill && tsc -p examples/stress",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && vitest run",
    "dev": "pnpm build && (tsc -b --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env apps/control-plane/dist/main.js)",
    "start": "node --env-file-if-exists=.env apps/control-plane/dist/main.js",
    "stack:up": "docker compose -f deploy/compose/compose.dev.yaml up -d --wait",
    "stack:down": "docker compose -f deploy/compose/compose.dev.yaml down",
    "emit:schemas": "pnpm build && node packages/manifest/dist/emit-cli.js",
    "check:schemas": "pnpm build && node packages/manifest/dist/emit-cli.js --check",
    "lock:migrations": "node scripts/migrations-lock.mjs --update",
    "check:migrations": "node scripts/migrations-lock.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev:console": "pnpm --filter @volvel/console dev",
    "e2e": "node e2e/run.mjs",
    "e2e:changed": "node e2e/run.mjs --only-changed=${E2E_BASE:-main}",
    "docs:check": "tsc -b && node packages/docs/check.mjs --staleness && node packages/docs/generate.mjs && node packages/docs/check.mjs",
    "docs:export": "tsc -b && pnpm --filter @volvel/docs build && node packages/docs/export.mjs",
    "docs:generate": "tsc -b && node packages/docs/generate.mjs",
    "release:check": "pnpm build && node scripts/release-check.mjs",
    "changeset": "changeset",
    "release:version": "node scripts/version-packages.mjs",
    "docs:screenshots": "SCREENSHOTS=1 node e2e/run.mjs screenshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@changesets/cli": "^3.1.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
