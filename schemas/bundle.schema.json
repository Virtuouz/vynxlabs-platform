{
  "type": "object",
  "required": [
    "formatVersion",
    "sdkVersion",
    "core",
    "manifests",
    "code",
    "digest"
  ],
  "properties": {
    "formatVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ],
      "description": "2 adds `assets`. 3 lets a manifest be console-managed, and then speaks for every console-managed resource of the workspace. 4 lets a manifest carry `key`, `title`, `mcp` and `source`. A bundle is written in the oldest format that can carry it."
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "core": {
      "type": "object",
      "required": [
        "min",
        "below"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Lowest core version it runs on."
        },
        "below": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "First core version it does not run on."
        }
      },
      "additionalProperties": false
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "schemaVersion",
          "path",
          "ownership",
          "body"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 63
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
            "maxLength": 255
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
            "maxLength": 255,
            "description": "The resource's identity, unique within the workspace. It never changes. Left out when it is the path the resource was made at."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What people read."
          },
          "mcp": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "description": "The name of the tool an agent sees, chosen by the author."
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "required": [
              "file",
              "generated"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "The file that defines the resource, relative to the repository root."
              },
              "generated": {
                "type": "boolean",
                "description": "Whether the file runs code to produce the resource, so only the repository can change it."
              }
            },
            "additionalProperties": false
          },
          "ownership": {
            "anyOf": [
              {
                "type": "string",
                "const": "code"
              },
              {
                "type": "string",
                "const": "ui"
              }
            ]
          },
          "body": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "code": {
      "type": "string",
      "description": "One ES module exporting every code-backed resource."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "app",
          "path",
          "sha256",
          "size",
          "contentType"
        ],
        "properties": {
          "app": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
            "maxLength": 255,
            "description": "The path of the app resource the file belongs to."
          },
          "path": {
            "type": "string",
            "pattern": "^[_.]?[A-Za-z0-9][A-Za-z0-9._@~-]*(/[_.]?[A-Za-z0-9][A-Za-z0-9._@~-]*)*$",
            "maxLength": 500,
            "description": "The file's path inside the app, for example assets/index-3f9a.js."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "contentType": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "maxItems": 5000,
      "description": "The files of the bundle's apps. From format 2."
    },
    "sources": {
      "type": "object",
      "required": [
        "files",
        "map"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500,
                "description": "Relative to the repository root."
              },
              "content": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 2000
        },
        "map": {
          "type": "string",
          "description": "A source map (version 3) from `code` to the files, without their contents."
        }
      },
      "additionalProperties": false
    },
    "consoleSources": {
      "type": "object",
      "required": [
        "files",
        "line",
        "map"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 500,
                "description": "`<path>.<kind>.ts`."
              },
              "content": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 2000
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "description": "How many lines of `code` come before the console's compiled code."
        },
        "map": {
          "type": "string",
          "description": "A source map (version 3) from the console's compiled code to the files."
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the other fields."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle.schema.json",
  "title": "Bundle",
  "description": "An immutable package of one workspace's manifests and code.",
  "additionalProperties": false
}
