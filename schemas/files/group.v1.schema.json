{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/group.v1.schema.json",
  "title": "group file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
      "description": "Its key, when that is not the file's name. It never changes."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(.*\\S)?$",
          "description": "What people read. It can change: nothing refers to it."
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "membership": {
          "type": "object",
          "description": "Who is in the group, when that is not managed by hand. Membership itself is never in a repository.",
          "properties": {
            "sso": {
              "type": "object",
              "description": "Whoever signs in with one of these values in the provider's groups claim is in the group.",
              "properties": {
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true
                }
              },
              "required": [
                "values"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
