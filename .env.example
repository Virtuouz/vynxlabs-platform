# Copy to .env for `pnpm dev`. These values match `pnpm stack:up`.
DATABASE_URL=postgres://platform:platform@localhost:54329/platform
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=platform
S3_ACCESS_KEY_ID=platform
S3_SECRET_ACCESS_KEY=platform-dev-secret
PORT=8080
LOG_LEVEL=info

# The URL you open in the browser. With `pnpm dev:console` that is the Vite
# server on 5173. Without it, the control plane serves the built console on 8080.
PUBLIC_URL=http://localhost:8080

# Development-only values. Generate real ones with `openssl rand -hex 32` and
# `openssl rand -base64 32`.
AUTH_SECRET=dev-only-auth-secret-dev-only-auth-secret
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kZXYtb25seS1rZXk=

# Creates the first operator admin when the instance has no members.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Optional: a second address for apps. See docs/self-hosting.md.
# APPS_URL=http://apps.localhost:8080

# Optional: mail for end users' invitations and password resets.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Platform <no-reply@localhost>
