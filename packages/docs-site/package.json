{
  "name": "@volvel/docs-site",
  "version": "0.5.0",
  "type": "module",
  "description": "A docs site's pages, drawn: the stylesheet, the script, the icons and the page functions that turn a set of documentation into HTML that works with scripts off.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@volvel/docs-engine": "workspace:*",
    "@volvel/markup": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
