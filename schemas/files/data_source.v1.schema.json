{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/data_source.v1.schema.json",
  "title": "data_source file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's identity, when that is not its path. Say it when you move the file: the path the resource had. It never changes."
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's path, when the file is kept somewhere that does not give it one."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "connector": {
          "const": "postgres"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "connector"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "body"
  ],
  "additionalProperties": false
}
