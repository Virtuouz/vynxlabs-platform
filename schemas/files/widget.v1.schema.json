{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/widget.v1.schema.json",
  "title": "widget file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's identity, when that is not its path. Say it when you move the file: the path the resource had. It never changes."
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's path, when the file is kept somewhere that does not give it one."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^x/[a-z][a-z0-9-]{0,40}$",
          "description": "The widget's type, in the tenant's own namespace: `x/<name>`. The other namespaces are Volvel's. A resource's path is its type."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semver. A page names the type; a deploy pins the version it was built with."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One line, said in \"Add to page\"."
        },
        "category": {
          "enum": [
            "records",
            "action",
            "understand",
            "organize",
            "content"
          ]
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "app",
              "dashboard"
            ]
          },
          "description": "Where it may be put: an app's page, a dashboard."
        },
        "data": {
          "type": "object",
          "description": "What it reads, by input name: the platform reads it under the viewer's permissions and gives it to the view.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "shape": {
                "enum": [
                  "rows",
                  "summary",
                  "record",
                  "approvals"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 100
              },
              "required": {
                "type": "boolean"
              },
              "sources": {
                "type": "array",
                "items": {
                  "enum": [
                    "table",
                    "query",
                    "sql",
                    "approvals"
                  ]
                }
              },
              "values": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "breakdowns": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "shape"
            ],
            "additionalProperties": false
          }
        },
        "dataHints": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object"
          },
          "description": "The Data tab's controls for each input."
        },
        "config": {
          "type": "object",
          "description": "A JSON Schema (draft 2020-12) for the widget's settings, an object with `properties`, each with an `x-volvel` hint saying how the inspector draws it from the fixed set of controls.",
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "properties"
          ]
        },
        "words": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "object"
        },
        "events": {
          "type": "object",
          "description": "What can happen to the widget that an action may be attached to, by name.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "gives": {
                "enum": [
                  "record",
                  "group",
                  "nothing"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "payload": {
                "type": "object",
                "description": "A JSON Schema for what the frame sends with it. The host drops what does not fit."
              }
            },
            "required": [
              "gives",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "min": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                }
              },
              "required": [
                "w",
                "h"
              ],
              "additionalProperties": false
            },
            "default": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                }
              },
              "required": [
                "w",
                "h"
              ],
              "additionalProperties": false
            },
            "max": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                }
              },
              "required": [
                "w",
                "h"
              ],
              "additionalProperties": false
            },
            "phone": {
              "enum": [
                "stack",
                "list",
                "hide"
              ]
            },
            "frame": {
              "enum": [
                "card",
                "none"
              ]
            }
          },
          "required": [
            "min",
            "default"
          ],
          "additionalProperties": false
        },
        "entry": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_@.-]+(/[A-Za-z0-9_@.-]+)*$",
          "maxLength": 500,
          "description": "The file in the repository that is the view: a module that draws it with `@volvel/widget-frame`. Built into one script at deploy."
        }
      },
      "required": [
        "type",
        "version",
        "title",
        "description",
        "category",
        "icon",
        "surfaces",
        "data",
        "config",
        "events",
        "layout",
        "entry"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "body"
  ],
  "additionalProperties": false
}
