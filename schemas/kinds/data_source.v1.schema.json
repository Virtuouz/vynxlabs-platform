{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/data_source.v1.schema.json",
  "title": "data_source body, version 1",
  "type": "object",
  "properties": {
    "connector": {
      "const": "postgres",
      "description": "What kind of database it is. Only `postgres` is read."
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "What it is for, in plain text."
    }
  },
  "required": [
    "connector"
  ],
  "additionalProperties": false
}
