{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/flow.v1.schema.json",
  "title": "flow file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's identity, when that is not its path. Say it when you move the file: the path the resource had. It never changes."
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's path, when the file is kept somewhere that does not give it one."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "What it is for, in plain text."
        },
        "nodes": {
          "type": "object",
          "description": "The steps of the flow, by name. Each is of one type, and what it may say depends on it.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 63
          },
          "minProperties": 1,
          "maxProperties": 200,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "description": "Where a flow starts. A flow may have several, and a run begins at the one that fired. What starts it is its `trigger`, one of the starts listed on the starts page.",
                "properties": {
                  "type": {
                    "const": "trigger",
                    "description": "Always `trigger`."
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 63,
                    "description": "What names this start for as long as the flow lives. A webhook's address, a form's address, a pause and the time it last fired follow the key when the step is renamed. Left out, the step's own name is the key."
                  },
                  "trigger": {
                    "description": "How the flow starts, and what it is given.",
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "Started from the console, the API, the command line, an agent or another flow. Its `input` is a JSON Schema the input must match.",
                        "properties": {
                          "type": {
                            "const": "manual",
                            "description": "Always `manual`."
                          },
                          "input": {
                            "type": "object",
                            "description": "A JSON Schema the input must match when the flow is started by hand, from the API, by an agent or as a sub-flow."
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "Starts when its address is called. It may check a signature, answer at once or hold the request open for an Answer step.",
                        "properties": {
                          "type": {
                            "const": "webhook",
                            "description": "Always `webhook`."
                          },
                          "source": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                            "maxLength": 255,
                            "description": "A trigger source to hand each request or each tick to first. What it returns is what starts the script or flow."
                          },
                          "input": {
                            "enum": [
                              "body",
                              "request"
                            ],
                            "description": "What the script or flow is given. `body` is the parsed body alone, and the default. `request` is `{ body, headers, rawBody, query, method }`, for a sender whose headers matter."
                          },
                          "verify": {
                            "type": "object",
                            "description": "Checks that a request was signed with a shared secret before anything starts. A request that fails is answered 401. Covers senders that put an HMAC of the body in a header, such as GitHub, Shopify and Slack.",
                            "properties": {
                              "scheme": {
                                "enum": [
                                  "hmac-sha256",
                                  "hmac-sha1"
                                ],
                                "description": "The way the signature is made: HMAC with SHA-256, or with SHA-1."
                              },
                              "header": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9-]+$",
                                "maxLength": 100,
                                "description": "The header the signature is sent in."
                              },
                              "secret": {
                                "type": "string",
                                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                                "description": "The name of the workspace secret that holds the shared secret."
                              },
                              "encoding": {
                                "enum": [
                                  "hex",
                                  "base64"
                                ],
                                "description": "How the signature is written. Default hex."
                              },
                              "prefix": {
                                "type": "string",
                                "maxLength": 20,
                                "description": "Text before the signature in the header, such as `sha256=`."
                              },
                              "signed": {
                                "type": "string",
                                "maxLength": 100,
                                "description": "What was signed, with `{body}` for the raw body and `{timestamp}` for the timestamp header. Default `{body}`. Slack signs `v0:{timestamp}:{body}`."
                              },
                              "timestampHeader": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9-]+$",
                                "maxLength": 100,
                                "description": "A header holding when the request was sent, in seconds since 1970."
                              },
                              "toleranceSeconds": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 86400,
                                "description": "How old a request may be, by its timestamp header. Default 300."
                              }
                            },
                            "required": [
                              "scheme",
                              "header",
                              "secret"
                            ],
                            "additionalProperties": false
                          },
                          "tags": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            "description": "CEL expressions over `trigger`, what the trigger was given. Each gives one tag for the run it starts, such as `'order:' + string(trigger.id)`. A tag is up to 64 characters of a-z, 0-9 and _.:-; an expression that fails or gives anything else is left out."
                          },
                          "respond": {
                            "enum": [
                              "now",
                              "flow"
                            ],
                            "description": "`now` answers 202 as soon as the flow has started, and is the default. `flow` holds the request open for up to 25 seconds, for a respond step to answer."
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "Starts at times given as a cron line, in a time zone. While the last run from it is still going, `overlap` says whether a time is passed over or starts another run.",
                        "properties": {
                          "type": {
                            "const": "schedule",
                            "description": "Always `schedule`."
                          },
                          "cron": {
                            "type": "string",
                            "maxLength": 120,
                            "description": "Five-field cron expression."
                          },
                          "timezone": {
                            "type": "string",
                            "maxLength": 64,
                            "description": "IANA time zone. Default UTC."
                          },
                          "source": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                            "maxLength": 255,
                            "description": "A trigger source to hand each request or each tick to first. What it returns is what starts the script or flow."
                          },
                          "tags": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            "description": "CEL expressions over `trigger`, what the trigger was given. Each gives one tag for the run it starts, such as `'order:' + string(trigger.id)`. A tag is up to 64 characters of a-z, 0-9 and _.:-; an expression that fails or gives anything else is left out."
                          },
                          "overlap": {
                            "enum": [
                              "allow",
                              "skip"
                            ],
                            "description": "`skip` passes over a time while the flow's last run from this trigger is still going, and is the default. `allow` starts it anyway."
                          }
                        },
                        "required": [
                          "type",
                          "cron"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "Starts when an event of the workspace, or one Volvel publishes, is published, and the optional `filter` gives true.",
                        "properties": {
                          "type": {
                            "const": "event",
                            "description": "Always `event`."
                          },
                          "event": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                            "maxLength": 255,
                            "description": "The event to listen for."
                          },
                          "filter": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000,
                            "description": "CEL over `event`. The flow starts only when it is true."
                          },
                          "tags": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            "description": "CEL expressions over `trigger`, what the trigger was given. Each gives one tag for the run it starts, such as `'order:' + string(trigger.id)`. A tag is up to 64 characters of a-z, 0-9 and _.:-; an expression that fails or gives anything else is left out."
                          }
                        },
                        "required": [
                          "type",
                          "event"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "Starts when someone fills in a page Volvel serves from the fields the start lists.",
                        "properties": {
                          "type": {
                            "const": "form",
                            "description": "Always `form`."
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120,
                            "description": "The heading of the form's page."
                          },
                          "description": {
                            "type": "string",
                            "maxLength": 1000,
                            "description": "What is said under the heading, to whoever fills the form in."
                          },
                          "fields": {
                            "type": "array",
                            "description": "What the form asks, in order. Each answer is a field of the input.",
                            "minItems": 1,
                            "maxItems": 30,
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]*$",
                                  "maxLength": 63,
                                  "description": "The key the value has in the input."
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 120,
                                  "description": "What the field is called on the page."
                                },
                                "type": {
                                  "enum": [
                                    "text",
                                    "textarea",
                                    "email",
                                    "number",
                                    "date",
                                    "select",
                                    "checkbox"
                                  ],
                                  "description": "What kind of answer it takes: a line of text, several lines, an email address, a number, a date, one of a list or a checkbox."
                                },
                                "required": {
                                  "type": "boolean",
                                  "description": "Whether the form can be sent with it empty."
                                },
                                "help": {
                                  "type": "string",
                                  "maxLength": 300,
                                  "description": "A line under the field that says what to put in it."
                                },
                                "options": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 120
                                  },
                                  "minItems": 1,
                                  "maxItems": 100,
                                  "uniqueItems": true,
                                  "description": "What a select offers."
                                }
                              },
                              "required": [
                                "name",
                                "label",
                                "type"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "submitLabel": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40,
                            "description": "What the button that sends the form says."
                          },
                          "success": {
                            "type": "string",
                            "maxLength": 500,
                            "description": "What is shown once the form was sent."
                          },
                          "access": {
                            "enum": [
                              "anyone",
                              "signed_in"
                            ],
                            "description": "Who may send the form. `signed_in` asks for a sign-in to the tenant's portal first. Default `anyone`."
                          }
                        },
                        "required": [
                          "type",
                          "title",
                          "fields"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "trigger"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Runs a script of the workspace, or a node, on a worker, with the input the step works out. The flow goes on when the script ends, and takes the error path when it fails.",
                "properties": {
                  "type": {
                    "const": "script",
                    "description": "Always `script`."
                  },
                  "script": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                    "maxLength": 255,
                    "description": "The script to run."
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "One expression for the whole input of the script."
                  },
                  "inputs": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                      "maxLength": 63
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "description": "A CEL expression."
                    },
                    "maxProperties": 50,
                    "description": "An expression for each field of the script's input."
                  },
                  "with": {
                    "type": "object",
                    "properties": {
                      "connections": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                          "maxLength": 255
                        },
                        "maxItems": 20,
                        "uniqueItems": true,
                        "description": "Connections the script may reach in this step, beyond what it declares itself."
                      },
                      "tables": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                          "maxLength": 255
                        },
                        "maxItems": 20,
                        "uniqueItems": true,
                        "description": "Tables the script may reach in this step, beyond what it declares itself."
                      },
                      "events": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                          "maxLength": 255
                        },
                        "maxItems": 20,
                        "uniqueItems": true,
                        "description": "Events the script may reach in this step, beyond what it declares itself."
                      }
                    },
                    "additionalProperties": false,
                    "description": "What the script may reach in this step, beyond what it declares itself: a connection, a table or an event, as the script says it takes."
                  }
                },
                "required": [
                  "type",
                  "script"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Works out values from expressions and names them, so that later steps read them in one place.",
                "properties": {
                  "type": {
                    "const": "set",
                    "description": "Always `set`."
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "description": "A CEL expression."
                    },
                    "minProperties": 1,
                    "maxProperties": 50,
                    "description": "An expression for each value, by the name it is given."
                  }
                },
                "required": [
                  "type",
                  "values"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Goes one way. The cases are tried in order, and the flow leaves by the first whose `when` is true, or by `otherwise` when none is.",
                "properties": {
                  "type": {
                    "const": "branch",
                    "description": "Always `branch`."
                  },
                  "cases": {
                    "type": "array",
                    "description": "The ways the flow may go, tried in order. The flow leaves by the first whose `when` is true, or by `otherwise` when none is.",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "maxLength": 63,
                          "description": "What an edge names to leave by this case."
                        },
                        "when": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000,
                          "description": "An expression that gives true when the flow goes this way."
                        }
                      },
                      "required": [
                        "name",
                        "when"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "type",
                  "cases"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Answers the request of a webhook whose flow holds it open. Only a flow whose webhook says `respond: flow` may have one.",
                "properties": {
                  "type": {
                    "const": "respond",
                    "description": "Always `respond`."
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 599,
                    "description": "The status the request is answered with. Default 200."
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[A-Za-z0-9-]+$",
                      "maxLength": 100
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "description": "A CEL expression."
                    },
                    "maxProperties": 20,
                    "description": "An expression for each header. Each must give text."
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression. An object or a list is sent as JSON, and text as it is."
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Runs a script or a flow once for each item of a list, of at most 1000 items, with a limit on how many run at once. The flow goes on when every item has ended.",
                "properties": {
                  "type": {
                    "const": "foreach",
                    "description": "Always `foreach`."
                  },
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression that gives the list to go through."
                  },
                  "script": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                    "maxLength": 255,
                    "description": "The script to run for each item."
                  },
                  "flow": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                    "maxLength": 255,
                    "description": "The flow to run for each item."
                  },
                  "flowFrom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression that gives the path of the flow to start. It must give one of the paths in `allow`."
                  },
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                      "maxLength": 255
                    },
                    "minItems": 1,
                    "maxItems": 50,
                    "uniqueItems": true,
                    "description": "The flows `flowFrom` may choose. Each is checked like a flow named outright: it must exist, be startable, and not lead back here."
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression for what each run is given, worked out with `item` and `index`."
                  },
                  "concurrency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "description": "How many items run at once."
                  },
                  "continueOnError": {
                    "type": "boolean",
                    "description": "Whether a failed item lets the others carry on. A failed item is then `{ error: { message } }` in the output, and the step succeeds."
                  },
                  "with": {
                    "type": "object",
                    "properties": {
                      "connections": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                          "maxLength": 255
                        },
                        "maxItems": 20,
                        "uniqueItems": true,
                        "description": "Connections the script may reach in this step, beyond what it declares itself."
                      },
                      "tables": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                          "maxLength": 255
                        },
                        "maxItems": 20,
                        "uniqueItems": true,
                        "description": "Tables the script may reach in this step, beyond what it declares itself."
                      },
                      "events": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                          "maxLength": 255
                        },
                        "maxItems": 20,
                        "uniqueItems": true,
                        "description": "Events the script may reach in this step, beyond what it declares itself."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Waits for every path that leads into it before the flow goes on.",
                "properties": {
                  "type": {
                    "const": "join",
                    "description": "Always `join`."
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Pauses the flow for a number of seconds. No worker is held while it waits.",
                "properties": {
                  "type": {
                    "const": "delay",
                    "description": "Always `delay`."
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2592000,
                    "description": "How long to wait, in seconds."
                  }
                },
                "required": [
                  "type",
                  "seconds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Pauses the flow until a person with permission decides. It goes on when the decision is to approve, and takes the error path, with the reason given, when it is to reject.",
                "properties": {
                  "type": {
                    "const": "approval",
                    "description": "Always `approval`."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "What is asked of the person who decides."
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression for the details shown beside the question."
                  },
                  "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2592000,
                    "description": "How long the approval waits, in seconds, before it fails."
                  },
                  "approvers": {
                    "type": "object",
                    "description": "Who may decide, beyond holding approval:write: a member of one of these groups, or one bound to one of these roles.",
                    "properties": {
                      "groups": {
                        "type": "array",
                        "maxItems": 20,
                        "description": "Groups whose members may decide.",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "roles": {
                        "type": "array",
                        "maxItems": 20,
                        "description": "Roles whose holders may decide.",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "surface": {
                    "enum": [
                      "workspace",
                      "tenant"
                    ],
                    "description": "Where the approval is listed while it waits: in its workspace alone, or on the tenant's page as well. Left out, its workspace alone."
                  }
                },
                "required": [
                  "type",
                  "title"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Starts another flow of the workspace, from its manual start, and waits for it to end.",
                "properties": {
                  "type": {
                    "const": "subflow",
                    "description": "Always `subflow`."
                  },
                  "flow": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                    "maxLength": 255,
                    "description": "The flow to run."
                  },
                  "flowFrom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression that gives the path of the flow to start. It must give one of the paths in `allow`."
                  },
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                      "maxLength": 255
                    },
                    "minItems": 1,
                    "maxItems": 50,
                    "uniqueItems": true,
                    "description": "The flows `flowFrom` may choose. Each is checked like a flow named outright: it must exist, be startable, and not lead back here."
                  },
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression for the input the other flow is started with."
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "Ends the flow as failed, with a message.",
                "properties": {
                  "type": {
                    "const": "fail",
                    "description": "Always `fail`."
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "An expression that gives the message the flow fails with."
                  }
                },
                "required": [
                  "type",
                  "message"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 1000,
          "description": "Which step goes on to which. A step with no edge out is the end of that path.",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "The step it leaves."
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "The step it goes to."
              },
              "output": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "For a branch: the case it leaves by, or `otherwise`."
              },
              "error": {
                "type": "boolean",
                "description": "Taken when the step it leaves fails, and only then."
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "description": "Where each node sits in the editor, for a flow drawn in the console. It changes nothing about how the flow runs.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 63
          },
          "maxProperties": 200,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "description": "Across, in pixels."
              },
              "y": {
                "type": "integer",
                "description": "Down, in pixels."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "body"
  ],
  "additionalProperties": false
}
