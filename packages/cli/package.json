{
  "name": "@volvel/cli",
  "version": "0.6.0",
  "type": "module",
  "description": "The volvel command: builds a tenant's repository and deploys it, runs scripts, and moves tenants between instances.",
  "license": "Apache-2.0",
  "bin": {
    "volvel": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/volvel.mjs",
    "dist/widget-host.js",
    "dist/screens",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "bundle": "node bundle.mjs",
    "prepack": "node bundle.mjs"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "volvel": "./dist/volvel.mjs"
    },
    "exports": {
      ".": "./dist/volvel.mjs"
    }
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "@volvel/compose": "workspace:*",
    "@volvel/control-plane": "workspace:*",
    "@volvel/docs-engine": "workspace:*",
    "@volvel/docs-site": "workspace:*",
    "@volvel/example-acme": "workspace:*",
    "@volvel/manifest": "workspace:*",
    "@volvel/markup": "workspace:*",
    "@volvel/worker": "workspace:*"
  }
}
