# Settings for the single-host stack. Avoid characters that need escaping in a URL.

# Long random values, for example from `openssl rand -hex 24`.
POSTGRES_PASSWORD=
OBJECTSTORE_SECRET=

# Signs session cookies. `openssl rand -hex 32`
AUTH_SECRET=

# Wraps every tenant's encryption key. `openssl rand -base64 32`
# Back this up somewhere safe. Without it, no stored secret can ever be read again.
MASTER_KEY=
# Only while rotating the master key: the other key of the rotation. See
# "Rotating the master key" in docs/self-hosting.md.
MASTER_KEY_SECONDARY=

# The URL people type to reach the console, for example https://platform.example.com
PUBLIC_URL=http://localhost:8080

# Creates the first operator admin on the first start, when there are no members.
# The password needs at least 12 characters. Remove both lines afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# A second address for apps, for example https://apps.example.com, another hostname
# that reaches this same instance. Apps written as code are served there, never where the
# console's sign-in is. Without it they are not served at all, unless you knowingly set
# APPS_ON_CONSOLE_ADDRESS=true. Interfaces built in the console work either way.
# APPS_URL=
# APPS_ON_CONSOLE_ADDRESS=false

# Optional: where to send mail, for end users' invitations and password resets, and for
# approvers of a flow's approval step. Without it nothing is sent, and whoever asks for a
# link passes it on.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Acme <no-reply@example.com>

# Lets the worker host ask the control plane for work. `openssl rand -hex 32`
WORKER_HOST_TOKEN=

# Managed workers: a worker per tenant with work, started by the worker host, in a
# container on a network of its own. `process` starts them beside the control plane
# instead, only for tenants whose code only the operator writes. `false` starts none,
# for when every tenant is served by standalone workers.
# MANAGED_WORKERS=host

# The instance does not reach private or internal addresses for a tenant (an SSO
# provider's metadata, a Git remote, a data source). List the ones it may, as networks
# and host names, for example 10.20.0.0/16,git.internal
# EGRESS_ALLOW=

# Where the control plane listens on the host. Put a TLS-terminating reverse
# proxy in front of it before exposing it beyond this machine.
PLATFORM_BIND=127.0.0.1:8080

# Optional: a published image to run instead of building from source.
# PLATFORM_IMAGE=
