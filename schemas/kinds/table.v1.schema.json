{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinds/table.v1.schema.json",
  "title": "table body, version 1",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "What it is for, in plain text."
    },
    "columns": {
      "type": "object",
      "description": "The table's columns, by name. Every table also has `id`, `created_at` and `updated_at`.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 55
      },
      "minProperties": 1,
      "maxProperties": 200,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "text",
              "integer",
              "number",
              "boolean",
              "timestamp",
              "date",
              "json",
              "uuid",
              "reference",
              "file",
              "enum",
              "enum_list"
            ],
            "description": "What the column holds."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "What the column holds, in plain text. Shown on the column's heading and wherever a page of documentation names the column."
          },
          "required": {
            "type": "boolean",
            "description": "Whether a row must have a value."
          },
          "unique": {
            "type": "boolean",
            "description": "Whether no two rows may hold the same value."
          },
          "default": {
            "description": "Used for a row that gives no value, and for existing rows when the column is added."
          },
          "references": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
            "maxLength": 255,
            "description": "For a reference: the table it points to."
          },
          "onDelete": {
            "enum": [
              "restrict",
              "set_null",
              "cascade"
            ],
            "description": "For a reference: what happens to this row when the row it points to is deleted. `restrict` refuses the deletion, `set_null` empties the column, `cascade` deletes this row too. Left out, `restrict`. The database does the last two: a row it deletes or empties this way is not announced as a row change, only the row that was deleted is."
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "description": "For an enum or an enum_list: the values a row may hold, in the order they are offered. A sort by the column goes by the spelling of the value, not by this order.",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^,\\n\\r]+$"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[^,\\n\\r]+$",
                      "description": "What the row holds."
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "What the value is called where people read it."
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^(gray|red|orange|amber|green|teal|blue|violet|pink|#[0-9a-fA-F]{6})$",
                      "description": "A color by name, or as #rrggbb."
                    },
                    "renamedFrom": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[^,\\n\\r]+$",
                      "description": "The value's previous spelling. Rows that hold it are rewritten."
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "renamedFrom": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "The column's previous name. Its data is kept."
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "display": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "The column that stands for a row where another table refers to it, in place of its ID."
    },
    "policy": {
      "description": "Who may read and change the rows of the table, beyond what a role gives. Left out, the rows are open to whoever the roles allow.",
      "oneOf": [
        {
          "type": "object",
          "description": "Every row is open to whoever the roles allow.",
          "properties": {
            "type": {
              "const": "open",
              "description": "Always `open`."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A person sees and changes only the rows that name them in a column.",
          "properties": {
            "type": {
              "const": "owner",
              "description": "Always `owner`."
            },
            "column": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "The column holding each row's owner."
            }
          },
          "required": [
            "type",
            "column"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Rules that match a row's columns against the person asking. A person sees a row when any rule lets them, and changes it when a `write` or `all` rule does.",
          "properties": {
            "type": {
              "const": "rules",
              "description": "Always `rules`."
            },
            "rules": {
              "type": "array",
              "description": "The rules, each saying who it lets in and what it lets them do.",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "allow": {
                    "enum": [
                      "read",
                      "write",
                      "all"
                    ],
                    "description": "What the rule lets a person do with the rows it matches."
                  },
                  "when": {
                    "description": "Which rows, and which people, the rule matches.",
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "Every person, for every row.",
                        "properties": {
                          "everyone": {
                            "const": true,
                            "description": "Always `true`."
                          }
                        },
                        "required": [
                          "everyone"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "A row whose column holds the person asking.",
                        "properties": {
                          "column": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "description": "The column the person is looked for in."
                          },
                          "is": {
                            "const": "principal",
                            "description": "Always `principal`."
                          }
                        },
                        "required": [
                          "column",
                          "is"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "A row whose column holds a group the person is in.",
                        "properties": {
                          "column": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "description": "The column the person's groups are looked for in."
                          },
                          "in": {
                            "const": "groups",
                            "description": "Always `groups`."
                          }
                        },
                        "required": [
                          "column",
                          "in"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "description": "A row whose column equals an attribute of the person.",
                        "properties": {
                          "column": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "description": "The column that is compared."
                          },
                          "equals": {
                            "type": "object",
                            "description": "What the column is compared with.",
                            "properties": {
                              "attribute": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                                "description": "The name of the attribute of the person."
                              }
                            },
                            "required": [
                              "attribute"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "column",
                          "equals"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "allow",
                  "when"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "rules"
          ],
          "additionalProperties": false
        }
      ]
    },
    "indexes": {
      "type": "array",
      "maxItems": 20,
      "description": "Indexes to keep, each a list of the columns it covers, to make a lookup by them fast.",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "minItems": 1,
        "maxItems": 5
      }
    },
    "renamedFrom": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "maxLength": 255,
      "description": "The table's previous path. Its data is kept."
    }
  },
  "required": [
    "columns"
  ],
  "additionalProperties": false
}
