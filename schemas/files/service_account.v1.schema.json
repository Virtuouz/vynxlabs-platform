{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/service_account.v1.schema.json",
  "title": "service_account file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
      "description": "Its key, when that is not the file's name. It never changes."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^\\S(.*\\S)?$",
          "description": "What people read. It can change: nothing refers to it."
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
