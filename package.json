{
  "name": "vynxlabs-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @vynxlabs/console build",
    "typecheck": "tsc -b && tsc -p packages/ui && tsc -p packages/app && tsc -p apps/console && tsc -p examples/acme",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && vitest run",
    "dev": "pnpm build && (tsc -b --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env apps/control-plane/dist/main.js)",
    "start": "node --env-file-if-exists=.env apps/control-plane/dist/main.js",
    "stack:up": "docker compose -f deploy/compose/compose.dev.yaml up -d --wait",
    "stack:down": "docker compose -f deploy/compose/compose.dev.yaml down",
    "emit:schemas": "pnpm build && node packages/manifest/dist/emit-cli.js",
    "check:schemas": "pnpm build && node packages/manifest/dist/emit-cli.js --check",
    "lock:migrations": "node scripts/migrations-lock.mjs --update",
    "check:migrations": "node scripts/migrations-lock.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev:console": "pnpm --filter @vynxlabs/console dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
