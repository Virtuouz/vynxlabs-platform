{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "files/role.v1.schema.json",
  "title": "role file, version 1",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's identity, when that is not its path. Say it when you move the file: the path the resource had. It never changes."
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
      "description": "The resource's path, when the file is kept somewhere that does not give it one."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "What people read."
    },
    "schemaVersion": {
      "const": 1
    },
    "body": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 63,
          "description": "The name bindings refer to the role by. Small letters, digits and `_`."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "What it is for, in plain text."
        },
        "permissions": {
          "type": "array",
          "description": "What the role allows, each as `kind:verb` such as `table:read`, with `*` for either half. The permissions page lists them all.",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z][a-z0-9_]*):(\\*|read|write)$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "permissions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "body"
  ],
  "additionalProperties": false
}
